# Copy to .env. Generate API_KEY with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=replace-with-a-random-key
DATABASE_URL=sqlite:///./data/backend.db
MEDIA_DIR=data/media
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
COMFYUI_URL=http://127.0.0.1:8188
WORKFLOW_PATH=workflows/default.json
GENERATION_TIMEOUT=900
WORKER_LEASE_SECONDS=1200
# Docker only; generate a random hex password (no special URL characters).
POSTGRES_PASSWORD=replace-with-a-random-hex-password
