# start.sh generates new random keys only when .env is missing.
API_KEY=replace-with-a-random-key
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=sqlite:///./data/backend.db
MEDIA_DIR=data/media
TEXT_PROVIDER=ollama
IMAGE_PROVIDER=mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
CHAT_TEMPERATURE=0.7
CORS_ORIGINS=http://localhost:3000
COMFYUI_URL=http://127.0.0.1:8188
WORKFLOW_PATH=workflows/default.json
GENERATION_TIMEOUT=900
WORKER_LEASE_SECONDS=1200
# Chat photos (adult NSFW by default): the character decides when to send one.
CHAT_IMAGE_ENABLED=true
CHAT_IMAGE_NSFW=true
CHAT_IMAGE_COOLDOWN_SECONDS=300
CHAT_WORKFLOW_PATH=workflows/chat_default.json
